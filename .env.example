# Server Configuration
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<db_username>:<url_encoded_password>@<cluster-host>/smart_campus?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_secure_random_64_character_secret
JWT_EXPIRES=1d
CLIENT_URL=http://localhost:5173

# Email / SMTP Configuration (Optional: falls back to ethereal/console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Smart Campus" <no-reply@campus.edu>

# Client Configuration
VITE_API_URL=/api
